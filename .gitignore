# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log

# Private Lovable database exports contain production rows. Keep reviewed
# schema-only snapshots under supabase/schema/ instead.
/private-schema-exports/
/lovable-cloud-exports/
*.dump
*.backup
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

# Local env overrides. The tracked root `.env` holds only public VITE_*
# client configuration required by the Lovable/Replit publish artifact
# (see .env.example). Never put server secrets in either file.
.env.local
.env.*.local

# Replit
.cache/
.local/
