{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "true",
    "build": "cd artifacts/syncareer && node node_modules/vite/bin/vite.js build",
    "build:dev": "cd artifacts/syncareer && node node_modules/vite/bin/vite.js build --mode development",
    "test": "cd artifacts/syncareer && node node_modules/vitest/vitest.mjs run",
    "typecheck": "cd artifacts/syncareer && node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "dev": "cd artifacts/syncareer && node node_modules/vite/bin/vite.js --host 0.0.0.0"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
