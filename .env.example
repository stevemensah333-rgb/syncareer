# Syncareer environment variables — NAMES ONLY, never commit real values here.
#
# Scope: these are browser-exposed Vite variables. They are public client
# configuration, not secrets. Server secrets (SUPABASE_SERVICE_ROLE_KEY,
# LOVABLE_API_KEY, PAYSTACK_SECRET_KEY, FIRECRAWL_API_KEY, ...) belong ONLY in
# Lovable Cloud's edge-function secret store — see docs/BACKEND_PLATFORM_INVENTORY.md §6.
#
# The root `.env` is intentionally tracked: the Lovable/Replit publish artifact
# reads these three managed values at build time (see PUBLISH_TROUBLESHOOTING.md).
# Put personal overrides in `.env.local`, which is git-ignored.

# --- Required: Supabase / Lovable Cloud client ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Optional: payments (Paystack public key; verification is server-side) ---
VITE_PAYSTACK_PUBLIC_KEY=

# --- Optional: analytics ---
VITE_POSTHOG_API_KEY=
